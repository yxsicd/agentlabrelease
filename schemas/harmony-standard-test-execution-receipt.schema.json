{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/harmony-standard-test-execution-receipt.schema.json",
  "title": "AgentLab Harmony standard test execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "sourceSetSha256", "projectTreeSha256", "framework", "status", "passed", "command", "target", "bundle", "module", "runner", "testClass", "hdc", "packages", "report", "logs", "startedAt", "finishedAt", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.harmony_standard_test_execution_receipt.v1"},
    "caseId": {"type": "string", "minLength": 1},
    "sourceSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "framework": {"const": "instrument-test-ohosTest-hypium"},
    "status": {"enum": ["passed", "failed", "infrastructure-error"]},
    "passed": {"type": "boolean"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target": {"type": "string", "minLength": 1},
    "bundle": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "minLength": 1},
    "testClass": {"type": ["string", "null"]},
    "hdc": {"$ref": "#/$defs/fileBinding"},
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "test"],
      "properties": {
        "app": {"$ref": "#/$defs/fileBinding"},
        "test": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "report": {"$ref": "#/$defs/fileBinding"},
    "logs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}},
    "startedAt": {"type": "string", "minLength": 1},
    "finishedAt": {"type": "string", "minLength": 1},
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byteLength": {"type": "integer", "minimum": 0}
      }
    }
  }
}
