{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/harmony-assessed-standard-test-receipt.schema.json",
  "title": "Assessed workspace Harmony standard-test receipt",
  "type": "object",
  "required": ["schema", "status", "caseId", "evaluationCaseSha256", "sourceSetSha256", "buildReceiptSha256", "projectTreeSha256", "framework", "sourceStandardTestReceiptSha256", "subjectTaskSucceeded", "failureClass", "assessedWorkspace", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.harmony_assessed_standard_test_receipt.v1"},
    "status": {"enum": ["passed-review-required", "assessed-failure-review-required"]},
    "caseId": {"type": "string", "minLength": 1},
    "evaluationCaseSha256": {"$ref": "#/$defs/sha256"},
    "sourceSetSha256": {"$ref": "#/$defs/sha256"},
    "buildReceiptSha256": {"$ref": "#/$defs/sha256"},
    "projectTreeSha256": {"$ref": "#/$defs/sha256"},
    "framework": {"const": "instrument-test-ohosTest-hypium"},
    "sourceStandardTestReceiptSha256": {"$ref": "#/$defs/sha256"},
    "subjectTaskSucceeded": {"type": "boolean"},
    "failureClass": {"enum": ["none", "standard-test"]},
    "assessedWorkspace": {"type": "object"},
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
