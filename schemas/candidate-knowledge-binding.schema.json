{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/candidate-knowledge-binding.schema.json",
  "title": "AgentLab Candidate Knowledge Binding",
  "type": "object",
  "required": ["schema", "candidateId", "candidateSha256", "sourceSetSha256", "knowledgeCutSha256", "repositoryBindings", "behaviorContract", "automaticPromotion"],
  "properties": {
    "schema": { "const": "agentlab.candidate_knowledge_binding.v1" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "sourceSetSha256": { "$ref": "#/$defs/sha256" },
    "knowledgeCutSha256": { "$ref": "#/$defs/sha256" },
    "caseId": { "type": "string", "minLength": 1 },
    "repositoryBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repositoryBinding" }
    },
    "behaviorContract": { "$ref": "#/$defs/behaviorContract" },
    "construction": {
      "type": "object",
      "required": ["taskDemands", "editablePaths", "contextPaths", "oracleRequirements"],
      "properties": {
        "taskDemands": { "$ref": "#/$defs/nonEmptyStrings" },
        "editablePaths": { "$ref": "#/$defs/nonEmptyStrings" },
        "contextPaths": { "$ref": "#/$defs/nonEmptyStrings" },
        "oracleRequirements": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "freeze": {
      "type": "object",
      "required": ["status", "acceptedVariants", "rejectedVariants", "independentReviewApproved"],
      "properties": {
        "status": { "const": "frozen" },
        "acceptedVariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "rejectedVariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "independentReviewApproved": { "const": true }
      }
    },
    "automaticPromotion": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage": {
      "type": "object",
      "required": ["architecture", "buildAndTestEntrypoints", "behaviorContracts", "stateTransitions", "crossFileResponsibilities", "knownGaps"],
      "properties": {
        "architecture": { "$ref": "#/$defs/nonEmptyStrings" },
        "buildAndTestEntrypoints": { "$ref": "#/$defs/nonEmptyStrings" },
        "behaviorContracts": { "$ref": "#/$defs/nonEmptyStrings" },
        "stateTransitions": { "$ref": "#/$defs/nonEmptyStrings" },
        "crossFileResponsibilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "knownGaps": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "repositoryBinding": {
      "type": "object",
      "required": ["repositoryId", "revision", "skuIds", "skillIds", "factIds", "analysisIds", "coverage"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "skuIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "skillIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "factIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "analysisIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "behaviorContract": {
      "type": "object",
      "required": ["responsibilities", "stateTransitions", "acceptanceObservables", "unresolvedRisks"],
      "properties": {
        "responsibilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "stateTransitions": { "$ref": "#/$defs/nonEmptyStrings" },
        "acceptanceObservables": { "$ref": "#/$defs/nonEmptyStrings" },
        "unresolvedRisks": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
