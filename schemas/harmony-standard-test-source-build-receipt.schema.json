{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/harmony-standard-test-source-build-receipt.schema.json",
  "title": "AgentLab Harmony standard-test source build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "sourceSetSha256", "projectTreeSha256", "framework", "status", "passed", "failureReasons", "command", "buildTarget", "buildTool", "sourceContract", "sourceIntegrityPreserved", "packages", "log", "startedAt", "finishedAt", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.harmony_standard_test_source_build_receipt.v1"},
    "caseId": {"type": "string", "minLength": 1},
    "sourceSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "framework": {"const": "instrument-test-ohosTest-hypium"},
    "status": {"enum": ["passed", "failed"]},
    "passed": {"type": "boolean"},
    "failureReasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "buildTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "testTarget", "product", "buildMode"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "testTarget": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "buildMode": {"type": "string", "minLength": 1}
      }
    },
    "buildTool": {"$ref": "#/$defs/fileBinding"},
    "sourceContract": {"$ref": "#/$defs/fileBinding"},
    "sourceIntegrityPreserved": {"type": "boolean"},
    "packages": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["app", "test"],
          "properties": {
            "app": {"$ref": "#/$defs/fileBinding"},
            "test": {"$ref": "#/$defs/fileBinding"}
          }
        },
        {"type": "null"}
      ]
    },
    "log": {"$ref": "#/$defs/fileBinding"},
    "startedAt": {"type": "string", "minLength": 1},
    "finishedAt": {"type": "string", "minLength": 1},
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byteLength": {"type": "integer", "minimum": 0}
      }
    }
  }
}
