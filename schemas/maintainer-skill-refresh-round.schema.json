{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/maintainer-skill-refresh-round.schema.json",
  "title": "Operational Maintainer Skill Refresh Round",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "roundIndex", "parentRoundSha256", "ownershipPlane", "focus", "tables", "coverage", "changes", "residualGaps", "decision", "automaticPromotion"],
  "properties": {
    "schema": { "const": "agentlab.maintainer_skill_refresh_round.v1" },
    "id": { "type": "string", "minLength": 1 },
    "roundIndex": { "type": "integer", "minimum": 1 },
    "parentRoundSha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "ownershipPlane": { "const": "target-operations" },
    "focus": { "$ref": "#/$defs/nonEmptyStrings" },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processSkillsSha256", "scopeSkillsSha256", "programFactsSha256"],
      "properties": {
        "processSkillsSha256": { "$ref": "#/$defs/sha256" },
        "scopeSkillsSha256": { "$ref": "#/$defs/sha256" },
        "programFactsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCount", "trackedFileCount", "processSkillCount", "scopeSkillCount"],
      "properties": {
        "repositoryCount": { "type": "integer", "minimum": 1 },
        "trackedFileCount": { "type": "integer", "minimum": 1 },
        "processSkillCount": { "type": "integer", "minimum": 1 },
        "scopeSkillCount": { "type": "integer", "minimum": 1 }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "updated", "retired"],
      "properties": {
        "added": { "$ref": "#/$defs/strings" },
        "updated": { "$ref": "#/$defs/strings" },
        "retired": { "$ref": "#/$defs/strings" }
      }
    },
    "residualGaps": { "$ref": "#/$defs/strings" },
    "decision": { "enum": ["continue", "converged", "blocked"] },
    "automaticPromotion": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
