{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/case-path-attempt-input.schema.json",
  "title": "Completed long-horizon path attempt input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "qualifiedDispatch", "attemptId", "participantId", "trialOrdinal", "stages", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.case_path_attempt_input.v1"},
    "status": {"const": "completed"},
    "qualifiedDispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["qualifiedDispatchId", "sha256"],
      "properties": {
        "qualifiedDispatchId": {"type": "string", "pattern": "^case-path-qualified-dispatch-[0-9a-f]{20}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attemptId": {"$ref": "#/$defs/token"},
    "participantId": {"$ref": "#/$defs/token"},
    "trialOrdinal": {"type": "integer", "minimum": 1},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "byteLength": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["checkId", "verdict", "evidence"],
      "properties": {"checkId": {"$ref": "#/$defs/token"}, "verdict": {"enum": ["pass", "fail", "error"]}, "evidence": {"$ref": "#/$defs/fileBinding"}}
    },
    "resourceObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "dimensions", "metricsEvidence"],
      "properties": {
        "status": {"enum": ["not-measured", "within-envelope", "violation"]},
        "dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["performance", "power", "thermal"]}},
        "metricsEvidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fileBinding"}]}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "nodeId", "caseId", "preState", "postState", "transitionEvidence", "functionalVerdict", "checks", "resourceObservation"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "nodeId": {"type": "string", "pattern": "^case-node-[0-9a-f]{20}$"},
        "caseId": {"$ref": "#/$defs/token"},
        "preState": {"$ref": "#/$defs/fileBinding"},
        "postState": {"$ref": "#/$defs/fileBinding"},
        "transitionEvidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fileBinding"}]},
        "functionalVerdict": {"enum": ["pass", "fail", "error"]},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "resourceObservation": {"$ref": "#/$defs/resourceObservation"}
      }
    }
  }
}
