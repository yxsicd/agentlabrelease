{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.dev/schemas/shadow-case-candidate.schema.json",
  "title": "Non-promoted shadow case candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "repositoryId", "sourceRevision", "sourceSetSha256", "knowledgeCutSha256", "maintainerSkillRefreshRoundId", "scopeSkillIds", "factIds", "title", "mechanism", "stagedDemands", "editablePaths", "contextPaths", "oracleHypothesis", "limitations", "lineage", "status", "automaticPromotion"],
  "properties": {
    "schema": { "const": "agentlab.shadow_case_candidate.v1" },
    "id": { "type": "string", "pattern": "^shadow-case-[a-z0-9-]{8,140}$" },
    "repositoryId": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceSetSha256": { "$ref": "#/$defs/sha256" },
    "knowledgeCutSha256": { "$ref": "#/$defs/sha256" },
    "maintainerSkillRefreshRoundId": { "type": "string", "minLength": 1 },
    "scopeSkillIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "factIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "title": { "type": "string", "minLength": 8, "maxLength": 180 },
    "mechanism": { "type": "string", "minLength": 80, "maxLength": 1600 },
    "stagedDemands": { "$ref": "#/$defs/nonEmptyStrings" },
    "editablePaths": { "$ref": "#/$defs/nonEmptyStrings" },
    "contextPaths": { "$ref": "#/$defs/strings" },
    "oracleHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "observables", "requiredEnvironment", "wrongVariants", "status"],
      "properties": {
        "framework": { "enum": ["ohosTest", "repository-test"] },
        "observables": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredEnvironment": { "$ref": "#/$defs/nonEmptyStrings" },
        "wrongVariants": { "$ref": "#/$defs/nonEmptyStrings" },
        "status": { "const": "hypothesis-unqualified" }
      }
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["loopReceiptSha256"]}, {"required": ["operationInputsSha256"]}],
      "dependentRequired": {
        "parentCandidateId": ["parentCandidateSha256", "parentKnowledgeCutSha256", "refreshedFactSha256", "focusedRefreshReceiptSha256"]
      },
      "properties": {
        "loopReceiptSha256": { "$ref": "#/$defs/sha256" },
        "operationInputsSha256": { "$ref": "#/$defs/sha256" },
        "focusedRefreshReceiptSha256": { "$ref": "#/$defs/sha256" },
        "parentCandidateId": { "type": "string", "pattern": "^shadow-case-[a-z0-9-]{8,140}$" },
        "parentCandidateSha256": { "$ref": "#/$defs/sha256" },
        "parentKnowledgeCutSha256": { "$ref": "#/$defs/sha256" },
        "refreshedFactSha256": { "$ref": "#/$defs/sha256" },
        "shadowRequestValueSha256": { "$ref": "#/$defs/sha256" },
        "runtimeTarget": { "enum": ["harmony-emulator", "repository-test"] }
      }
    },
    "status": { "const": "shadow-proposal" },
    "automaticPromotion": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
