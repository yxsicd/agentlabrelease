{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "automaticPromotion", "decision", "beforeAssessmentSha256", "afterAssessmentSha256", "selectedScopeIds", "advancedScopeIds", "maintenanceReadyDelta", "nextRoundObjectives", "authorityWritePerformed"],
  "properties": {
    "schema": { "const": "agentlab.maintainer_operation_round_result.v1" },
    "automaticPromotion": { "const": false },
    "authorityWritePerformed": { "const": false },
    "decision": { "enum": ["review-proposed-operation-knowledge", "no-change"] },
    "beforeAssessmentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "afterAssessmentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selectedScopeIds": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "advancedScopeIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "maintenanceReadyDelta": { "type": "integer", "minimum": 0, "maximum": 4 },
    "nextRoundObjectives": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    { "if": { "properties": { "decision": { "const": "no-change" } } }, "then": { "properties": { "maintenanceReadyDelta": { "const": 0 }, "advancedScopeIds": { "maxItems": 0 } } }, "else": { "properties": { "maintenanceReadyDelta": { "minimum": 1 }, "advancedScopeIds": { "minItems": 1 } } } }
  ]
}
