{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/harmony-assessed-campaign-handoff.schema.json",
  "title": "AgentLab portable Harmony assessed campaign handoff",
  "type": "object",
  "required": ["schema", "campaignId", "caseId", "sourceSetSha256", "methodRevision", "evaluationCase", "calibration", "attemptCollection", "attempts", "automaticPromotion", "nextGate"],
  "properties": {
    "schema": {"const": "agentlab.harmony_assessed_campaign_handoff.v1"},
    "campaignId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "caseId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sourceSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "methodRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluationCase": {"$ref": "#/$defs/file"},
    "calibration": {"$ref": "#/$defs/file"},
    "attemptCollection": {"$ref": "#/$defs/file"},
    "attempts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["attemptId", "participantId", "assessment"],
        "properties": {
          "attemptId": {"type": "string"},
          "participantId": {"type": "string"},
          "producerRun": {},
          "assessment": {
            "type": "object",
            "required": ["path", "summary", "decisionPackage", "finalSourceState", "workspace"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "summary": {"$ref": "#/$defs/file"},
              "decisionPackage": {"$ref": "#/$defs/file"},
              "finalSourceState": {"$ref": "#/$defs/file"},
              "workspace": {
                "type": "object",
                "required": ["path", "treeSha256", "fileCount"],
                "properties": {
                  "path": {"$ref": "#/$defs/relativePath"},
                  "treeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "fileCount": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "automaticPromotion": {"const": false},
    "nextGate": {"const": "resolve-on-qualified-harmony-host"}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
    "file": {
      "type": "object",
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byteLength": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
