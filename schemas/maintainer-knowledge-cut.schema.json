{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/maintainer-knowledge-cut.schema.json",
  "title": "AgentLab Maintainer Knowledge Cut",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceSetSha256", "repositories", "tables", "policy", "automaticPromotion"],
  "properties": {
    "schema": { "const": "agentlab.maintainer_knowledge_cut.v1" },
    "sourceSetSha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maintainerSkills", "maintainerScopeSkills", "maintainerSkillRefreshRounds", "programFacts", "evaluationCases"],
      "properties": {
        "maintainerSkills": { "$ref": "#/$defs/table" },
        "maintainerScopeSkills": { "$ref": "#/$defs/table" },
        "maintainerSkillRefreshRounds": { "$ref": "#/$defs/table" },
        "programFacts": { "$ref": "#/$defs/table" },
        "evaluationCases": { "$ref": "#/$defs/table" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wholeRepositoryInventoryRequired", "semanticCoverageRequired", "programAnalysisBound", "candidateBindingsRequired"],
      "properties": {
        "wholeRepositoryInventoryRequired": { "const": true },
        "semanticCoverageRequired": { "const": true },
        "programAnalysisBound": { "const": true },
        "candidateBindingsRequired": { "const": true }
      }
    },
    "automaticPromotion": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
