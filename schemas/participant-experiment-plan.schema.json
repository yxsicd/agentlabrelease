{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/participant-experiment-plan.schema.json",
  "title": "AgentLab predeclared participant capability experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "caseId", "sourceSetSha256", "evaluationCaseSha256", "caseReviewRunId", "methodRevision", "providerRoute", "trialsPerParticipant", "participantProfileCount", "participantProfiles", "executionProtocol", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.participant_experiment_plan.v1"},
    "status": {"const": "predeclared-before-attempts"},
    "caseId": {"$ref": "#/$defs/token"},
    "sourceSetSha256": {"$ref": "#/$defs/sha256"},
    "evaluationCaseSha256": {"$ref": "#/$defs/sha256"},
    "caseReviewRunId": {"type": "integer", "minimum": 1},
    "methodRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "providerRoute": {"$ref": "#/$defs/token"},
    "trialsPerParticipant": {"enum": [3, 5, 10, 20]},
    "participantProfileCount": {"type": "integer", "minimum": 3, "maximum": 8},
    "participantProfiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "participantId", "model"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
          "participantId": {"$ref": "#/$defs/token"},
          "model": {"$ref": "#/$defs/token"}
        }
      }
    },
    "executionProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "agentImplementation", "agentPackage", "agentPackageVersion", "participantAdapter", "participantDriver", "participantPackageLockSha256", "participantRuntimeConfigSha256", "runtimeImageId", "participantManifestSha256", "promptAuthority", "sessionPolicy", "thinkingMode", "reasoningEffort", "extensionPolicy", "skillsPolicy", "contextFilePolicy", "turnTimeoutSeconds", "samplingPolicy", "withinCampaignExecutionProtocolQualified", "crossCampaignProviderReproducibilityQualified"],
      "properties": {
        "schema": {"const": "agentlab.participant_execution_protocol.v1"},
        "agentImplementation": {"const": "pi"},
        "agentPackage": {"const": "@mariozechner/pi-coding-agent"},
        "agentPackageVersion": {"$ref": "#/$defs/token"},
        "participantAdapter": {"$ref": "#/$defs/fileBinding"},
        "participantDriver": {"$ref": "#/$defs/fileBinding"},
        "participantPackageLockSha256": {"$ref": "#/$defs/sha256"},
        "participantRuntimeConfigSha256": {"$ref": "#/$defs/sha256"},
        "runtimeImageId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "participantManifestSha256": {"$ref": "#/$defs/sha256"},
        "promptAuthority": {"const": "digest-bound-adapter-driver-and-blind-case-manifest"},
        "sessionPolicy": {"const": "fresh-per-attempt-persistent-across-case-stages"},
        "thinkingMode": {"const": "off"},
        "reasoningEffort": {"type": "null"},
        "extensionPolicy": {"const": "disabled"},
        "skillsPolicy": {"const": "disabled"},
        "contextFilePolicy": {"const": "disabled"},
        "turnTimeoutSeconds": {"const": 420},
        "samplingPolicy": {"const": "provider-default-stochastic-repeated-trials"},
        "withinCampaignExecutionProtocolQualified": {"const": true},
        "crossCampaignProviderReproducibilityQualified": {"const": false}
      }
    },
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/token"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
