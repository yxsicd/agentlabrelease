{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.invalid/schemas/harmony-assessed-host-profile.schema.json",
  "title": "AgentLab qualified Harmony host profile",
  "type": "object",
  "required": ["schema", "profileId", "sourceMaterialization", "build", "standardTest", "device", "programs", "automaticPromotion"],
  "properties": {
    "schema": {"const": "agentlab.harmony_assessed_host_profile.v1"},
    "profileId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sourceMaterialization": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "build": {"type": "object", "required": ["executable"], "properties": {"executable": {"$ref": "#/$defs/file"}}, "additionalProperties": true},
    "standardTest": {
      "type": "object",
      "required": ["sourceExecutor", "configuration"],
      "properties": {
        "sourceExecutor": {"$ref": "#/$defs/file"},
        "configuration": {"type": "object"}
      },
      "additionalProperties": false
    },
    "device": {"type": "object"},
    "programs": {
      "type": "object",
      "required": ["build", "standardTest", "loop", "run", "compose", "collect", "score", "feedback"],
      "additionalProperties": {"$ref": "#/$defs/file"}
    },
    "executionPreflight": {
      "type": "object",
      "required": ["requiredGroups", "requiredDevices"],
      "properties": {
        "requiredGroups": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requiredDevices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "read", "write"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "read": {"const": true},
              "write": {"const": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "requiredTrials": {"type": "integer", "minimum": 1},
    "eligibilityThreshold": {"type": "number", "minimum": 0, "maximum": 1},
    "automaticPromotion": {"const": false}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
