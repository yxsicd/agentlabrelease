  "checks": [
    {"id": "harmony-invalid-data-is-not-finished", "stage": "harmony-finalization", "behavior": "Malformed purchase data must not reach finishPurchase and must remain observable as an error."},
    {"id": "harmony-finished-order-is-not-finished-again", "stage": "harmony-finalization", "behavior": "An already-finished order must not be submitted to finishPurchase again."},
    {"id": "harmony-pending-order-forwards-exact-identity", "stage": "harmony-finalization", "behavior": "A pending order must forward its exact type, token and order id to finishPurchase."},
    {"id": "harmony-missing-product-type-blocks-finish", "stage": "harmony-finalization", "behavior": "A decoded order without product type must not reach the external finish sink."},
    {"id": "harmony-finish-rejection-is-observable", "stage": "harmony-finalization", "behavior": "A rejected finishPurchase promise must be observed through the selected error path."},
    {"id": "cordova-owned-items-preserve-indexed-purchase-data", "stage": "cordova-consumption", "behavior": "Each owned item must retain the purchase-data value at the same response index."},
    {"id": "cordova-consume-forwards-exact-purchase-data", "stage": "cordova-consumption", "behavior": "The selected purchase-data string must be forwarded unchanged as inAppPurchaseData."},
    {"id": "cordova-success-resets-and-reloads", "stage": "cordova-consumption", "behavior": "A successful consume result must clear stale collections and request a reload."},
    {"id": "cordova-business-failure-retains-state-and-alerts", "stage": "cordova-consumption", "behavior": "A nonzero consume result must retain current state and expose the business failure."},
    {"id": "cordova-rejection-retains-state-and-logs", "stage": "cordova-consumption", "behavior": "A rejected consume promise must retain current state and expose the rejection."}
