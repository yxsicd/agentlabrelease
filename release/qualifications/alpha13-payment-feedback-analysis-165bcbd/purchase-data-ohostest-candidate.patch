+ */
+
+import { FinishStatus, PurchaseData, PurchaseOrderPayload } from './IapDataModel';
+
+export interface FinishPurchaseRequest {
+  productType: number;
+  purchaseToken: string;
+  purchaseOrderId: string;
+}
+
+export class PurchaseFinalizationPlan {
+  shouldFinish: boolean = false;
+  reason: string = '';
+  request: FinishPurchaseRequest = {
+    productType: 0,
+    purchaseToken: '',
+    purchaseOrderId: ''
+  };
+}
+
+export function planPurchaseFinalization(
+  purchaseData: string,
+  decodeJws: (jws: string) => string
+): PurchaseFinalizationPlan {
+  const plan = new PurchaseFinalizationPlan();
+  try {
+    const jwsPurchaseOrder = (JSON.parse(purchaseData) as PurchaseData).jwsPurchaseOrder;
+    if (!jwsPurchaseOrder) {
+      plan.reason = 'missing-jws-purchase-order';
+      return plan;
+    }
+
+    const purchaseOrderPayload =
+      JSON.parse(decodeJws(jwsPurchaseOrder)) as PurchaseOrderPayload;
+    if (purchaseOrderPayload.finishStatus === FinishStatus.FINISHED) {
+      plan.reason = 'already-finished';
+      return plan;
+    }
+    if (!purchaseOrderPayload.productType) {
+      plan.reason = 'missing-product-type';
+      return plan;
+    }
+
+    plan.shouldFinish = true;
+    plan.reason = 'finish-required';
+    plan.request = {
+      productType: Number(purchaseOrderPayload.productType),
+      purchaseToken: purchaseOrderPayload.purchaseToken,
+      purchaseOrderId: purchaseOrderPayload.purchaseOrderId
+    };
+    return plan;
+  } catch (e) {
+    plan.reason = 'invalid-purchase-data';
+    return plan;
+  }
+}
+
+export function finishPlannedPurchase(
+  plan: PurchaseFinalizationPlan,
+  finishPurchase: (request: FinishPurchaseRequest) => Promise<void>
+): Promise<void> {
+  if (!plan.shouldFinish) {
+    return Promise.resolve();
+  }
+  return finishPurchase(plan.request);
+}
