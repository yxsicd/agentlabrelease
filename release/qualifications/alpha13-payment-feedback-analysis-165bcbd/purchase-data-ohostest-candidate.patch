@@ -0,0 +1,97 @@
+import { describe, it, expect } from '@ohos/hypium';
+import {
+  finishPlannedPurchase,
+  FinishPurchaseRequest,
+  planPurchaseFinalization,
+  PurchaseFinalizationPlan
+} from '../../../main/ets/common/PurchaseFinalizationPolicy';
+
+function identityDecode(jws: string): string {
+  return jws;
+}
+
+function failingDecode(_jws: string): string {
+  throw new Error('decode failed');
+}
+
+function purchaseData(payload: string): string {
+  return JSON.stringify({
+    type: 0,
+    jwsPurchaseOrder: payload
+  });
+}
+
+export default function purchaseFinalizationPolicyTest() {
+  describe('PurchaseFinalizationPolicyTest', () => {
+    it('missingJwsDoesNotFinish', 0, () => {
+      const plan = planPurchaseFinalization(JSON.stringify({ type: 0 }), identityDecode);
+      expect(plan.shouldFinish).assertFalse();
+      expect(plan.reason).assertEqual('missing-jws-purchase-order');
+    })
+
+    it('malformedDataDoesNotFinish', 0, () => {
+      const plan = planPurchaseFinalization('{', identityDecode);
+      expect(plan.shouldFinish).assertFalse();
+      expect(plan.reason).assertEqual('invalid-purchase-data');
+    })
+
+    it('decodeFailureDoesNotFinish', 0, () => {
+      const plan = planPurchaseFinalization(purchaseData('invalid-jws'), failingDecode);
+      expect(plan.shouldFinish).assertFalse();
+      expect(plan.reason).assertEqual('invalid-purchase-data');
+    })
+
+    it('alreadyFinishedPurchaseDoesNotFinishAgain', 0, () => {
+      const plan = planPurchaseFinalization(purchaseData(JSON.stringify({
+        productId: 'p1',
+        productType: '0',
+        purchaseOrderId: 'order-1',
+        purchaseToken: 'token-1',
+        finishStatus: '1'
+      })), identityDecode);
+      expect(plan.shouldFinish).assertFalse();
+      expect(plan.reason).assertEqual('already-finished');
+    })
+
+    it('pendingPurchaseForwardsExactFinishFields', 0, () => {
+      const plan = planPurchaseFinalization(purchaseData(JSON.stringify({
+        productId: 'p1',
+        productType: '0',
+        purchaseOrderId: 'order-2',
+        purchaseToken: 'token-2',
+        finishStatus: '2'
+      })), identityDecode);
+      expect(plan.shouldFinish).assertTrue();
+      expect(plan.request.productType).assertEqual(0);
+      expect(plan.request.purchaseToken).assertEqual('token-2');
+      expect(plan.request.purchaseOrderId).assertEqual('order-2');
+    })
+
+    it('missingProductTypeBlocksFinish', 0, () => {
+      const plan = planPurchaseFinalization(purchaseData(JSON.stringify({
+        productId: 'p1',
+        productType: '',
+        purchaseOrderId: 'order-3',
+        purchaseToken: 'token-3',
+        finishStatus: '2'
+      })), identityDecode);
+      expect(plan.shouldFinish).assertFalse();
+      expect(plan.reason).assertEqual('missing-product-type');
+    })
+
+    it('finishRejectionRemainsObservable', 0, async () => {
+      const plan = new PurchaseFinalizationPlan();
+      plan.shouldFinish = true;
+      let rejected = false;
+      try {
+        await finishPlannedPurchase(
+          plan,
+          (request: FinishPurchaseRequest): Promise<void> => Promise.reject(new Error('finish failed'))
+        );
+      } catch (e) {
+        rejected = true;
+      }
+      expect(rejected).assertTrue();
+    })
+  })
+}
